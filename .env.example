# Application
APP_NAME=Trade Command Center
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///./backend/runtime/trade_command_center_dev.db

# Security
# Generate strong local development values before authentication work begins.
JWT_SECRET_KEY=replace-with-a-development-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# MT5 execution agent
MT5_AGENT_BASE_URL=http://127.0.0.1:8100
MT5_AGENT_SHARED_SECRET=replace-with-a-development-agent-secret

# Broker passwords and exchange API secrets must NEVER be committed here.
# Live credentials will later be stored in an approved OS-backed secret store.
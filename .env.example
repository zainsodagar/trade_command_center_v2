# Application
APP_NAME=Trade Command Center
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///./runtime/trade_command_center_dev.db

# Security
# Generate a strong local development value before starting authentication work.
JWT_SECRET_KEY=replace-with-a-development-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# MT5 execution agent
MT5_AGENT_BASE_URL=http://127.0.0.1:8100
MT5_AGENT_SHARED_SECRET=replace-with-a-development-agent-secret

# Broker credentials must never be committed here.
# Store live credentials in Windows Credential Manager or another approved secret store.
